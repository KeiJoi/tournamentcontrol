# Server network configuration
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:5173

# Use /var/data/vat-tournaments.sqlite in production on Render.
DATABASE_PATH=./data/vat-tournaments.sqlite

# Fake development-only values. Never reuse these in production.
SERVER_ACCESS_PASSWORD=development-only-server-password-change-me
MASTER_ADMIN_PASSWORD=development-only-master-password-change-me
SESSION_SECRET=development-only-session-secret-change-me-1234567890
RETENTION_DAYS=30
SQLITE_BACKUP_COUNT=7
